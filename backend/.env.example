# PayPilot AI - Backend Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_PORT=8000

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB_NAME=paypilot_ai

# --- Gemini API ---
GEMINI_API_KEY=

# --- Auth / Security (placeholder) ---
SECRET_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
